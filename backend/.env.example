# Existing required settings
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=5001
CORS_ORIGIN=https://your-admin-domain.vercel.app

# Automatic question import
QUESTION_IMPORT_SECRET=generate-a-long-random-secret
# Comma-separated raw GitHub JSON URLs. Each JSON is an array or {"questions":[]}.
QUESTION_SOURCE_URLS=https://raw.githubusercontent.com/OWNER/REPO/main/questions.json
# Optional free/public API endpoints; they must return the normalized JSON question shape.
QUESTION_API_URLS=https://your-free-api.example/questions

# Optional OpenAI-compatible chat-completions endpoint. AI generation is skipped if either value is absent.
QUESTION_AI_API_URL=https://api.example.com/v1/chat/completions
QUESTION_AI_API_KEY=your-provider-api-key
QUESTION_AI_MODEL=your-model-name  # required by your chosen provider
QUESTION_AI_BATCH_SIZE=25
