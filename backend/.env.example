# Existing required backend settings
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=5001
CORS_ORIGIN=https://your-admin-domain.vercel.app

# Secure question-import endpoint: generate with `openssl rand -hex 32`
QUESTION_IMPORT_SECRET=replace-with-a-unique-random-secret

# Free public trivia feed (no API key). The importer adapts Open Trivia DB's
# { response_code, results[] } format and maps general trivia to SSC / General Knowledge.
# This is supplementary trivia, NOT Indian exam PYQs or a verified exam source.
QUESTION_API_URLS=https://opentdb.com/api.php?amount=50&type=multiple&encode=url3986
QUESTION_DEFAULT_CATEGORY=SSC

# Optional: comma-separated direct JSON dataset URLs in canonical question format.
# Leave this variable unset until you have a dataset whose licence permits your use.
# QUESTION_SOURCE_URLS=https://raw.githubusercontent.com/OWNER/REPO/main/questions.json

# Groq OpenAI-compatible Chat Completions API (create your own key at https://console.groq.com/keys)
QUESTION_AI_API_URL=https://api.groq.com/openai/v1/chat/completions
QUESTION_AI_API_KEY=replace-with-your-own-groq-api-key
QUESTION_AI_MODEL=openai/gpt-oss-20b
QUESTION_AI_BATCH_SIZE=25
